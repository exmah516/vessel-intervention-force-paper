\relax 
\@writefile{loc}{\contentsline {replaced}{Replaced: \truncate {\Changestruncatewidth }{修改后的表述}}{1}{}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{这是一段需要删除的旧内容，长度足够跨过双栏中的一行，用于检查中文删除线和自动换行是否正常。}}{1}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{这是补充的说明。}}{1}{}\protected@file@percent }
\@writefile{loc}{\contentsline {comment}{Commented: \truncate {\Changestruncatewidth }{这里需要补充实验依据。}}{1}{}\protected@file@percent }
\gdef \@abspage@last{1}
